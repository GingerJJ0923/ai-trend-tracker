SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SB_SECRET_KEY
# Legacy fallback, if your project does not yet offer sb_secret_ keys:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Provider-neutral OpenAI-compatible Chat API. DeepSeek example:
CHAT_API_KEY=YOUR_DEEPSEEK_API_KEY
CHAT_BASE_URL=https://api.deepseek.com
RANKING_MODEL=deepseek-v4-flash
ANALYSIS_MODEL=deepseek-v4-pro

# Optional but recommended for multilingual candidate recall. GLM example:
EMBEDDING_API_KEY=YOUR_GLM_API_KEY
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=512

# Legacy OpenAI-only deployments remain supported:
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# GitHub Actions automatically supplies GITHUB_TOKEN. Set this locally if needed.
GITHUB_TOKEN=

# Optional: seeds tracks when the database has no track with the same name.
TRACKS_JSON=[{"name":"AI 工作流","goal":"关注能够改善知识工作和软件工作流、现在即可测试的 AI 产品；排除缺少差异化能力的简单套壳产品。"}]

# Multi-channel delivery: QQ SMTP (free) or Resend, plus ServerChan WeChat.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=personal@qq.com
SMTP_PASSWORD=QQ_MAIL_AUTHORIZATION_CODE
# Optional Resend fallback when SMTP credentials are absent.
RESEND_API_KEY=
DIGEST_FROM=personal@qq.com
# Separate multiple recipients with commas or semicolons.
DIGEST_TO=personal@qq.com,work@example.com
SERVERCHAN_SENDKEY=

LOOKBACK_HOURS=30
HN_ITEM_LIMIT=120
MATCH_CANDIDATES=30
DEEP_ANALYSIS_LIMIT=3
OUTPUT_LANGUAGE=zh-CN
REPORT_TIMEZONE=Asia/Shanghai
# Keep the first screen light: 3 detailed highlights, then up to 12 one-line signals per Track.
REPORT_HIGHLIGHT_ITEMS=3
REPORT_QUICK_ITEMS=12
REPORT_RELEVANCE_THRESHOLD=50
REPORT_SHOW_SCORES=false
# Manual recovery only. Keep false for scheduled runs to prevent duplicates.
FORCE_DIGEST=false
SOURCE_CONFIG=config/sources.json
